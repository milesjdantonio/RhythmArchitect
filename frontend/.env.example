# Base URL of the real backend. Leave empty to use the built-in mock server (vite dev / preview).
VITE_API_BASE_URL=

# Optional, mock server only (put it in .env.local, never in the app): a YouTube Data API v3 key
# lets "Generate beatmap" find a song's video by its name. Without one, paste the song's YouTube
# link into the Title field instead. Free from https://console.cloud.google.com (YouTube Data API v3).
YOUTUBE_API_KEY=
